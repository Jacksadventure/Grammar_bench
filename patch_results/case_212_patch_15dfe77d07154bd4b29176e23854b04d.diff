+def parse_M():
+    global pos, tokens
+    if pos >= len(tokens):
+        error("Unexpected end of input in M")
+    lookahead = tokens[pos]
+    if lookahead.startswith('>'):
+        match('>')
+    elif lookahead.startswith('A'):
+        match('A')
+        parse_Q()
+        parse_Q()
+    else:
+        error("Unexpected token " + lookahead + " in M, expected one of: " + ", ".join(['>', 'A']))
+
