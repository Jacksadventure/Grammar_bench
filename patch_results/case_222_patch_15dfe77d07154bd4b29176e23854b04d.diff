+def parse_U():
+    global pos, tokens
+    # Zero or more "T N k" sequences
+    while pos < len(tokens) and tokens[pos].startswith('T'):
+        match('T')
+        match('N')
+        match('k')
+
+    # Optional "m <X>" sequence
+    if pos < len(tokens) and tokens[pos].startswith('m'):
+        match('m')
+        parse_X()
 
