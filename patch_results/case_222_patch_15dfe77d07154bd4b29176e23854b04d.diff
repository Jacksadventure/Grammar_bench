+    global pos, tokens
+    # Zero or more 'p' tokens (the rule is left-recursive, converted to iteration)
+    while pos < len(tokens) and tokens[pos].startswith('p'):
+        match('p')
+
+    # <B> can be empty, so no error is raised if no 'p' is present
