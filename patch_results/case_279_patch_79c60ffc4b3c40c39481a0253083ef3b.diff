+def parse_U():
+    global pos, tokens
+    if pos >= len(tokens):
+        error("Unexpected end of input in U")
+    lookahead = tokens[pos]
+
+    # First(ZJR) = {A, *, %, q, J} (from Z: A,*,%,q plus J if Z is epsilon)
+    # First(Y) = {Y}
+    # First(oYJ) = {o}
+    # First(%n-) = {%}
+
+    # The '%' token is in First(ZJR) (via I in Z) and First(%n-). Resolve with 2-token lookahead.
+    if lookahead.startswith('%'):
+        if pos + 1 < len(tokens) and tokens[pos+1].startswith('n'):
+            match('%')
+            match('n')
+            match('-')
+        else: # Must be ZJR, where Z starts with I which starts with '%'
+            parse_Z()
+            match('J')
+            parse_R()
+    elif lookahead.startswith('A') or lookahead.startswith('*') or lookahead.startswith('q') or lookahead.startswith('J'): # First(ZJR) excluding '%'
+        parse_Z()
+        match('J')
+        parse_R()
+    elif lookahead.startswith('Y'):
+        match('Y')
+    elif lookahead.startswith('o'):
+        match('o')
+        match('Y')
+        match('J')
+    else:
+        error("Unexpected token " + lookahead + " in U, expected one of: " + ", ".join(['A', '*', '%', 'q', 'J', 'Y', 'o']))
